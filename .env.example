# ============================================================================
# Aguatería — variables de entorno
# Copiar a .env (local) o cargar en Vercel → Project → Settings → Environment Variables.
# NUNCA commitear secretos reales. .env está en .gitignore.
#
# LEYENDA
#   [privada]  Sólo backend / Serverless Function. Nunca llega al navegador ni al APK.
#   [pública]  Puede exponerse al cliente. En el front sólo se usan las VITE_*.
#   [build]    La usa el proceso de build, no en runtime.
# ============================================================================

# --- Entorno --------------------------------------------------------------
# development | preview | production   [privada]
APP_ENV=development
NODE_ENV=development
# Zona horaria de negocio. Todas las fechas "de día" se calculan acá.   [privada]
APP_TIMEZONE=America/Asuncion
APP_CURRENCY=PYG
LOG_LEVEL=info

# --- API HTTP -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Origen del front para CORS. En producción: el dominio exacto de Vercel.   [privada]
WEB_ORIGIN=http://localhost:5173
# Lista separada por comas si hay varios orígenes. En producción, dominios exactos.
CORS_ORIGINS=http://localhost:5173
# URL pública de la API (para QR de verificación y enlaces).   [privada]
# En Vercel (front y API en el mismo dominio): https://TU-APP.vercel.app
API_PUBLIC_URL=http://localhost:3001
# URL pública de la web (enlaces de recuperación de contraseña).   [privada]
APP_PUBLIC_URL=http://localhost:5173

# --- Autenticación propia (JWT HS256 + refresh en DB) ------------------------
# Generar con: openssl rand -base64 48    [privada] — OBLIGATORIA en producción
# La API rechaza el arranque en production si es "dev-only..." o el placeholder.
AUTH_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Base de datos: Supabase PostgreSQL ------------------------------------
# PRODUCCIÓN (Supabase):
#   DATABASE_URL  → cadena del "Connection Pooler" (Transaction, puerto 6543).
#                   Incluye ?sslmode=require. prepare:false ya está forzado en el código.
#   DIRECT_URL    → conexión directa (puerto 5432), sólo para migraciones/seed.
#   DATABASE_SSL=true
# Ejemplo (pooler):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Ejemplo (directa):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:cambiar-esta-clave@localhost:5432/aguateria_db
DIRECT_URL=
DATABASE_SSL=false
# Alternativa local: si DATABASE_URL está vacío se arma desde estos.   [privada]
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aguateria_db
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave

# --- Almacenamiento de archivos --------------------------------------------
# local  → disco (`data/uploads`). NO usar en Vercel (FS efímero).
# supabase → URLs firmadas contra Supabase Storage. USAR ESTE en producción.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=data/uploads
STORAGE_BUCKET_PHOTOS=meter-photos
STORAGE_BUCKET_DOCS=documents
STORAGE_BUCKET_TAX=tax-xml
STORAGE_BUCKET_KUDE=kude
STORAGE_BUCKET_EXPENSES=expense-vouchers

# Sólo si STORAGE_DRIVER=supabase
# URL del proyecto Supabase (https://<ref>.supabase.co)   [privada en este backend]
SUPABASE_URL=
# Clave anónima (sólo si el front hablara directo con Supabase; hoy NO se usa)   [pública]
SUPABASE_ANON_KEY=
# Service Role / Secret Key. FIRMA URLs de Storage en el servidor.
# [privada] — JAMÁS en Vite, en el navegador ni en el APK. Sólo Serverless.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Cron interno (Vercel Cron o invocación manual) -------------------------
# Vercel envía  Authorization: Bearer <CRON_SECRET>  al endpoint /api/internal/cron.
# Generar con: openssl rand -hex 32    [privada] — OBLIGATORIA en producción
CRON_SECRET=replace-with-cron-secret

# --- Email (SMTP real, nodemailer) ---------------------------------------------
# Necesario para la recuperación de contraseña en producción. Sin SMTP_HOST +
# SMTP_FROM el endpoint /auth/forgot-password responde igual (mensaje genérico)
# pero no envía nada. port 465 ⇒ TLS implícito; otro ⇒ STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# --- GPS / lecturas de campo (defaults; la empresa puede sobreescribir en DB) --
GPS_MAX_ACCURACY_METERS=30
GPS_REJECT_MOCK=true
EXCESSIVE_CONSUMPTION_MULTIPLIER=3

# --- Seed de demostración (SÓLO development) -------------------------------
# La API rechaza el arranque en production si ALLOW_DEV_SEED=true.
ALLOW_DEV_SEED=false
DEV_ADMIN_EMAIL=admin@aguateria.local
DEV_ADMIN_PASSWORD=ChangeMe_DevOnly_1

# --- SIFEN / DNIT (facturación electrónica Paraguay) ----------------------
# Sin certificado PKCS#12 + CSC + SIFEN_ENABLED=true el envío queda en
# SIFEN_NOT_CONFIGURED. No se simula una aprobación tributaria.
# test: sifen-test.set.gov.py | production: sifen.set.gov.py
SIFEN_ENVIRONMENT=test
SIFEN_ENABLED=false
SIFEN_HOST=sifen-test.set.gov.py
SIFEN_MANUAL_VERSION=150
# PKCS#12 en base64 o ruta en el servidor (NUNCA en el cliente).   [privada]
SIFEN_CERT_BASE64=
SIFEN_CERT_PATH=
SIFEN_CERT_PASSWORD=
# Código de Seguridad del Contribuyente (CSC) otorgado por DNIT.   [privada]
SIFEN_CSC_ID=
SIFEN_CSC=
SIFEN_TIMEOUT_MS=30000

# --- Frontend (Vite) — se leen en apps/web/.env, llegan al bundle -----------
# [pública] por diseño. No poner secretos acá.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
